# ==============================================================================
# WealthOps Backend Configuration Template
# Copy this file to .env and configure for your environment
# ==============================================================================

# Core Settings
PROJECT_NAME="WealthOps Agent"
VERSION="1.0.0"
ENVIRONMENT="development"       # "development" | "production" | "testing"
DEBUG=True
API_PREFIX="/api"

# Server Host & Port (Used by run.py and cloud deployments)
HOST="0.0.0.0"
PORT=8000

# Database
# Default: SQLite via aiosqlite (zero external dependencies, auto-seeds 24+ portfolios on boot)
# For production PostgreSQL / Supabase / Neon:
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/wealthops"
DATABASE_URL="sqlite+aiosqlite:///./wealthops.db"

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","*"]

# LLM Providers
# Default: "smart_mock" (high-fidelity deterministic intelligence with zero API keys required)
# Options: "smart_mock" | "gemini" | "openai" | "anthropic"
DEFAULT_LLM_PROVIDER="smart_mock"

# Optional Live LLM Keys (Set if you want live external model inference)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Fiduciary Risk Guardrails & Operational Limits
MAX_REBALANCE_CHANGE_PCT=5.0          # Drift > 5.0% triggers mandatory Risk Officer dual approval
MAX_TRANSACTION_VALUE_USD=100000.0    # Order volume > $100k blocks direct auto-execution
CONFIDENCE_THRESHOLD=0.85             # Intent confidence < 0.85 requires human review
STRICT_POLICY_ENFORCEMENT=True
